<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gift_registry_report_view_pivot" model="ir.ui.view">
        <field name="name">gift.registry.report.pivot</field>
        <field name="model">gift.registry.report</field>
        <field name="arch" type="xml">
            <pivot string="Conversión de listas">
                <field name="event_date" interval="month" type="row"/>
                <field name="event_type_id" type="col"/>
                <field name="qty_wanted" type="measure"/>
                <field name="qty_gifted" type="measure"/>
                <field name="is_gifted" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="gift_registry_report_view_graph" model="ir.ui.view">
        <field name="name">gift.registry.report.graph</field>
        <field name="model">gift.registry.report</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="event_date" interval="month"/>
                <field name="qty_gifted" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="gift_registry_report_action" model="ir.actions.act_window">
        <field name="name">Conversión de listas</field>
        <field name="res_model">gift.registry.report</field>
        <field name="view_mode">pivot,graph</field>
    </record>
</odoo>
