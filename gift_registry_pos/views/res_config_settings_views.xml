<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_gift_registry" model="ir.ui.view">
        <field name="name">res.config.settings.form.gift.registry.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_interface_section" position="inside">
                <setting id="gift_registry_setting" string="Listas de regalos"
                         help="Botón para buscar listas y vender desde ellas">
                    <field name="pos_gift_registry_enabled"/>
                    <div class="content-group mt-2" invisible="not pos_gift_registry_enabled">
                        <div class="row">
                            <label for="pos_gift_registry_days_before" class="col-lg-6 o_light_label"/>
                            <field name="pos_gift_registry_days_before"/>
                        </div>
                        <div class="row">
                            <label for="pos_gift_registry_days_after" class="col-lg-6 o_light_label"/>
                            <field name="pos_gift_registry_days_after"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
