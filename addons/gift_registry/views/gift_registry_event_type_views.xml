<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gift_registry_event_type_view_list" model="ir.ui.view">
        <field name="name">gift.registry.event.type.list</field>
        <field name="model">gift.registry.event.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="template_line_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="gift_registry_event_type_view_form" model="ir.ui.view">
        <field name="name">gift.registry.event.type.form</field>
        <field name="model">gift.registry.event.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Baby shower"/></h1>
                    </div>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="sequence" groups="base.group_no_one"/>
                    </group>
                    <separator string="Productos sugeridos"/>
                    <p class="text-muted">
                        Al crear una lista de este tipo se proponen estos productos, con cantidad 1.
                        En la lista se pueden cambiar o quitar antes de guardar.
                    </p>
                    <field name="template_line_ids" domain="[('sale_ok', '=', True)]">
                        <list>
                            <field name="default_code"/>
                            <field name="name"/>
                            <field name="list_price" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gift_registry_event_type_action" model="ir.actions.act_window">
        <field name="name">Tipos de evento</field>
        <field name="res_model">gift.registry.event.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
